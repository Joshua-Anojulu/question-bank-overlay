# Copy this file to `.env.local` and fill in your Supabase project values.
# Vite inlines these at BUILD time (npm run build), so you must rebuild after changing them.
# Without them, auth and sync throw "VITE_SUPABASE_URL is required" at runtime while
# local-only progress/notes still work.
#
# Find these in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
